# =============================================================================
#  Copy to .env.local and fill in. Nothing here is committed.
# =============================================================================

# --- Nhost project (Settings -> General in the Nhost dashboard) ---------------
# These two are the only public values; everything else must stay server-side.
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-subdomain
NEXT_PUBLIC_NHOST_REGION=ap-south-1

# Hasura admin secret. Used by the setup scripts and by the Action handlers to
# write engine tables (which grant no write permission to any user role).
NHOST_ADMIN_SECRET=your-hasura-admin-secret

# --- Shared secrets between Hasura and this app ------------------------------
# `npm run hasura:apply` generates these into .env.local if they are missing,
# and writes them into the Hasura metadata so only Hasura can call the handlers.
# Set the SAME values in your hosting provider's environment.
HASURA_ACTION_SECRET=
HASURA_WEBHOOK_SECRET=

# --- Where this app is reachable ---------------------------------------------
# Hasura calls Action / Event / Cron handlers at this origin, so it must be a
# URL Hasura can reach over the internet. localhost is fine for `npm run dev`,
# but Actions will not fire until this points at a deployment (see README).
APP_BASE_URL=http://localhost:3000

# How the browser invokes Actions:
#   hasura  (default) real GraphQL mutation -> Hasura -> handler. Use in production.
#   direct            browser -> handler route with its JWT. Use locally, before
#                     you have deployed, because Hasura cannot reach localhost.
NEXT_PUBLIC_ACTION_TRANSPORT=direct

# --- Fallback LLM for llm_call steps -----------------------------------------
# This is the *deployment's* provider, used by any llm_call step that has not
# picked one of its organization's own endpoints. Those live in the
# llm_connections table and are added in the app (Settings → LLM connections, or
# the Connection field on an llm_call node) — they need nothing here.
#
# groq | openrouter | openai | anthropic | gemini | custom | stub. Any free tier
# works. With no key configured the engine falls back to `stub`, which answers
# after a disclosed artificial delay and labels itself as stubbed in the step
# output, so a run is never silently faked.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# For LLM_PROVIDER=custom, or to point a named provider at a different host.
# Anything speaking OpenAI's /chat/completions works: vLLM, Ollama, LM Studio, a
# gateway. Private and loopback addresses are refused unless
# ALLOW_PRIVATE_HTTP_TARGETS=true, the same SSRF guard the http_request step uses.
LLM_BASE_URL=
LLM_API_KEY=

# --- notify step delivery (optional) ----------------------------------------
# A notify step with channel `log` needs none of this and is what the seeded
# demo uses. Set these to deliver for real.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Engine tuning (optional) -----------------------------------------------
# http_request steps refuse private/loopback/link-local targets by default so
# the engine cannot be used as an SSRF proxy. Set true only for local testing.
ALLOW_PRIVATE_HTTP_TARGETS=false
# Hard ceiling on step executions per run.
MAX_STEPS_PER_RUN=100
